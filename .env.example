# NEXT_PUBLIC_* values are public and read at BUILD time. Never put the Supabase service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. true ONLY when Cloudflare is the sole way to reach the app (VPS setup).
# TRUST_CLOUDFLARE_IP=false
# Optional: defaults to the single store created by supabase/schema.sql
# NEXT_PUBLIC_STORE_ID=00000000-0000-0000-0000-000000000001
